# Copy this file to config.env and fill in your own values. config.env stays out of git.
# Environment variables with the same names override the file.

# Azure subscription and resource group that will hold the Fabric capacity
FABDEMO_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
FABDEMO_RESOURCE_GROUP=rg-fabric-demos

# Fabric capacity: lowercase letters and digits only. An existing paused capacity with this name is resumed, not recreated.
FABDEMO_CAPACITY=fabcondemos
FABDEMO_SKU=F8
FABDEMO_REGION=francecentral

# Capacity administrator, usually your own sign-in name
FABDEMO_ADMIN=you@contoso.onmicrosoft.com

# Workspace the script creates and later deletes with "down"
FABDEMO_WORKSPACE=fabcon-recap-demo

# Language of the notebook comments, AI function labels, and data agent: en, pl, or de
FABDEMO_LANG=en
